---
---
<section class="hero container">
  <div class="hero-badge"><span class="dot"></span> v0.5.2 已发布 · MIT 开源</div>
  <h1>本地 AI Agent</h1>
  <p class="hero-sub">HClaw 是一款面向未来的本地 AI Agent 桌面客户端。多渠道接入、多模型动态切换、本地优先、全图形化配置。</p>
  <div class="hero-cta">
    <a href="/hclaw/#download" class="btn btn-primary">立即下载</a>
    <a href="/hclaw/#features" class="btn btn-ghost">了解特性</a>
  </div>
  <div class="hero-shot">
    <img src="/hclaw/home.png" alt="HClaw 主界面" />
  </div>
</section>

<style>
  .hero { padding: 136px 0 80px; text-align: center; }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: var(--bg-raised);
    font-size: 13px;
    color: var(--text-muted);
    margin-bottom: 28px;
  }
  .hero-badge .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }

  .hero h1 {
    font-size: clamp(2.8rem, 6.5vw, 4.4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 24px;
    color: var(--text);
    animation: hclaw-rise .55s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .hero-sub {
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    color: var(--text-muted);
    max-width: 560px;
    margin: 0 auto 36px;
    animation: hclaw-rise .55s cubic-bezier(0.16, 1, 0.3, 1) .08s both;
  }

  .hero-cta { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; margin-bottom: 40px; }

  .hero-shot {
    max-width: 820px;
    margin: 0 auto;
    border-radius: 14px;
    border: 1px solid var(--border-strong);
    overflow: hidden;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.5);
    background: var(--bg-raised);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px;
  }
  .hero-shot img { display: block; width: 100%; height: auto; }

  /* 唯一 authored 动效：hero 主标题一次性入场（指数缓出），
     默认态由 CSS 自行完成，不依赖 JS 触发；减少动效偏好下完全静止 */
  @keyframes hclaw-rise {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero h1,
    .hero-sub { animation: none; }
  }

  @media (max-width: 560px) {
    .hero { padding: 64px 0 48px; }
    .hero h1 {
      font-size: clamp(2rem, 8vw, 2.8rem);
      letter-spacing: -0.02em;
    }
  }
</style>
