---
const issuesHref = 'https://github.com/hamlin-zy/hclaw/issues';
const bilibiliHref = 'https://space.bilibili.com/3707005250308201';
---

<section id="community" class="container">
  <div class="section-head">
    <h2 class="section-title">加入社区</h2>
    <p class="section-desc">反馈问题、交流答疑、了解项目动态，和开发者聊两句。</p>
  </div>

  <div class="cm-grid">
    <a class="cm-main" href={issuesHref} target="_blank" rel="noopener">
      <div class="cm-main-icon">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/><path d="M9 18c-4.51 2-5-2-7-2" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/></svg>
      </div>
      <div class="cm-main-txt">
        <h3>GitHub Issues</h3>
        <p>反馈 Bug、提交需求，直接和开发者对话。</p>
      </div>
      <span class="cm-arrow" aria-hidden="true">→</span>
    </a>

    <div class="cm-list">
      <a class="cm-item" href={bilibiliHref} target="_blank" rel="noopener">
        <div class="cm-item-icon">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="6.5" width="19" height="13.5" rx="3" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M7 4l2.2 2.5M17 4l-2.2 2.5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/><path d="m10 10.5 4.5 2.5-4.5 2.5v-5Z" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linejoin="round"/></svg>
        </div>
        <div class="cm-item-txt">
          <strong>B站</strong>
          <span>介绍视频、安装教程</span>
        </div>
        <span class="cm-meta cm-meta--link">前往 →</span>
      </a>

      <div class="cm-item">
        <div class="cm-item-icon">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18V5l12-2v13" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/><circle cx="6" cy="18" r="3" stroke="currentColor" stroke-width="1.5" fill="none"/><circle cx="18" cy="16" r="3" stroke="currentColor" stroke-width="1.5" fill="none"/></svg>
        </div>
        <div class="cm-item-txt">
          <strong>抖音</strong>
          <span>安装教程、项目动态</span>
        </div>
        <span class="cm-meta">搜索 hamlin_zy</span>
      </div>

      <div class="cm-item">
        <div class="cm-item-icon">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/><circle cx="9" cy="7" r="4" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <div class="cm-item-txt">
          <strong>QQ 群</strong>
          <span>用户交流、答疑</span>
        </div>
        <span class="cm-meta">群 754207905</span>
      </div>
    </div>
  </div>
</section>

<style>
  /* Issues 主卡 + 三个紧凑入口，避免 4 张等大无差别卡片 */
  .cm-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 24px;
    align-items: stretch;
  }

  .cm-main {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 30px;
    border-radius: 14px;
    border: 1px solid var(--border);
    background: var(--bg-raised);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
    transition: transform .2s, border-color .2s, box-shadow .2s;
  }
  .cm-main:hover {
    transform: translateY(-2px);
    border-color: rgba(255, 107, 94, 0.35);
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.28);
  }
  .cm-main-icon {
    width: 52px;
    height: 52px;
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: var(--accent-soft);
    color: var(--accent);
  }
  .cm-main-icon svg { width: 28px; height: 28px; }
  .cm-main-txt h3 {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
  }
  .cm-main-txt p {
    margin-top: 4px;
    color: var(--text-muted);
    font-size: 14.5px;
    line-height: 1.65;
  }
  .cm-arrow {
    margin-left: auto;
    flex: none;
    color: var(--accent);
    font-size: 20px;
    font-weight: 600;
  }

  .cm-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  .cm-item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 18px;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--bg);
    transition: border-color .2s, background .2s;
  }
  a.cm-item:hover { border-color: var(--border-strong); background: var(--bg-raised); }
  .cm-item-icon {
    width: 36px;
    height: 36px;
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 9px;
    background: var(--accent-soft);
    color: var(--accent);
  }
  .cm-item-icon svg { width: 20px; height: 20px; }
  .cm-item-txt {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .cm-item-txt strong {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .cm-item-txt span {
    font-size: 13px;
    color: var(--text-muted);
  }
  .cm-meta {
    margin-left: auto;
    flex: none;
    font-size: 13px;
    color: var(--text-faint);
    white-space: nowrap;
  }
  .cm-meta--link { color: var(--accent); }

  @media (max-width: 900px) {
    .cm-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 620px) {
    .cm-main { flex-direction: column; align-items: flex-start; }
    .cm-arrow { margin-left: 0; }
  }
</style>
