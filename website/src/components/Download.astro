---
const platforms = [
  {
    icon: 'windows',
    name: 'Windows',
    ver: 'Windows 10 / 11 (x64)',
    featured: true,
  },
  {
    icon: 'macos',
    name: 'macOS',
    ver: 'Intel + Apple Silicon',
  },
  {
    icon: 'linux',
    name: 'Linux',
    ver: 'x64 (deb / AppImage)',
  },
];

const releases = 'https://github.com/hamlin-zy/hclaw/releases';
const baidu = 'https://pan.baidu.com/s/1EIlDiU-EiEEiF-oXrHhFdQ?pwd=nmhb';
---

<section id="download" class="container">
  <div class="section-head">
    <h2 class="section-title">现在就用 HClaw</h2>
    <p class="section-desc">下载双击即可运行，无需配置任何环境变量，升级不丢失本地配置。</p>
  </div>

  <div class="dl-grid">
    {platforms.map((p) => (
      <div class:list={['dl-card', { featured: p.featured }]}>
        <div class="dl-top">
          <div class="dl-icon">
            {
              p.icon === 'windows' && (
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 6.1 10 5v6.2H3.5V6.1ZM11.5 4.7l9-1.3v7.8h-9V4.7ZM3.5 12.9H10V19l-6.5-1v-5.1ZM11.5 12.9h9V20.7l-9-1.3v-6.5Z" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linejoin="round"/></svg>
              )
            }
            {
              p.icon === 'macos' && (
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.94c1.5 0 2.75 1.06 4 1.06 3 0 6-8 6-12.22A4.91 4.91 0 0 0 17 5c-2.22 0-4 1.44-5 2-1-.56-2.78-2-5-2a4.9 4.9 0 0 0-5 4.78C2 14 5 22 8 22c1.25 0 2.5-1.06 4-1.06Z" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linejoin="round"/><path d="M10 2c1 .5 2 2 2 5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/></svg>
              )
            }
            {
              p.icon === 'linux' && (
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="m6 9 3 3-3 3" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/><path d="M13 15h5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/></svg>
              )
            }
          </div>
          {p.featured && <span class="dl-badge">推荐</span>}
        </div>
        <h3>{p.name}</h3>
        <div class="dl-ver">{p.ver}</div>
        <a class="btn btn-primary btn-sm" href={releases} target="_blank" rel="noopener">下载安装包</a>
      </div>
    ))}
  </div>

  <p class="dl-note">
    也可以从 <a href={baidu} target="_blank" rel="noopener">百度网盘</a> 下载 · 完整版本记录见 <a href={releases} target="_blank" rel="noopener">GitHub Releases</a>
  </p>
</section>

<style>
  /* 三平台卡：Windows 列稍宽 + 「用户量最多」徽标，形成层次而非等大机械网格 */
  .dl-grid {
    display: grid;
    grid-template-columns: 1.22fr 1fr 1fr;
    gap: 20px;
    align-items: stretch;
  }

  .dl-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 28px 28px 30px;
    border-radius: 14px;
    border: 1px solid var(--border);
    background: var(--bg-raised);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
    transition: transform .2s, border-color .2s, box-shadow .2s;
  }
  .dl-card:hover {
    transform: translateY(-2px);
    border-color: var(--border-strong);
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.28);
  }
  .dl-card.featured { background: var(--bg-raised-2); }

  .dl-top {
    width: 100%;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 22px;
  }
  .dl-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: var(--accent-soft);
    color: var(--accent);
  }
  .dl-icon svg { width: 26px; height: 26px; }

  .dl-badge {
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--accent);
    border: 1px solid rgba(255, 107, 94, 0.3);
    background: var(--accent-soft);
  }

  .dl-card h3 {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
  }
  .dl-ver {
    margin-top: 6px;
    color: var(--text-muted);
    font-size: 14px;
  }

  /* 按钮贴底，三卡高度不等时底部对齐 */
  .dl-card .btn { margin-top: auto; }

  .dl-note {
    margin-top: 28px;
    text-align: center;
    color: var(--text-faint);
    font-size: 14px;
  }
  .dl-note a {
    color: var(--text-muted);
    border-bottom: 1px solid var(--border-strong);
    transition: color .2s, border-color .2s;
  }
  .dl-note a:hover { color: var(--accent); border-color: var(--accent); }

  @media (max-width: 900px) {
    .dl-grid { grid-template-columns: 1fr 1fr; }
    .dl-card.featured { grid-column: 1 / -1; }
  }
  @media (max-width: 620px) {
    .dl-grid { grid-template-columns: 1fr; }
  }
</style>
