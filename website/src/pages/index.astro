---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Highlights from '../components/Highlights.astro';
import Features from '../components/Features.astro';
import Timeline from '../components/Timeline.astro';
import Download from '../components/Download.astro';
import Community from '../components/Community.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="HClaw — 本地 AI Agent 桌面客户端" description="HClaw 是一款面向未来的本地 AI Agent 桌面客户端。多渠道接入、多模型动态切换、本地优先、全图形化配置。像微信一样简单，下载双击即用。">
  <div class="glow"></div>
  <Nav />
  <main>
    <Hero />
    <Highlights />
    <Features />
    <Timeline />
    <Download />
    <Community />
  </main>
  <Footer />
</BaseLayout>
